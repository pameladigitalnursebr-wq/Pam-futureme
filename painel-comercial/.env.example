# Copie para .env e ajuste. Nunca commite o .env.
PAINEL_DATABASE_URL=postgresql://painel:troque-esta-senha@localhost:5432/painel
# Segredo para assinar as sessões do painel (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))")
PAINEL_SECRET_KEY=troque-por-um-segredo-longo
# Domínio de e-mail aceito para usuários
PAINEL_DOMINIO_EMAIL=futureme.tech
# Duração da sessão do painel, em horas
PAINEL_SESSAO_HORAS=12
# Percentual máximo de registros que uma importação completa pode desativar sem confirmação
PAINEL_LIMITE_REMOCAO=0.20
# Cookie de sessão só via HTTPS. Use false apenas em desenvolvimento local (http://localhost).
PAINEL_COOKIE_SEGURO=true
# Domínio público do serviço, para o endpoint MCP aceitar chamadas do Claude (ex.: painel.futureme.tech)
PAINEL_HOSTS_MCP=
